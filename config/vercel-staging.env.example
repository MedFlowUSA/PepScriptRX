# Configure these for Preview and the isolated staging project's non-customer-facing deployment only.
# VERCEL_ENV is supplied by Vercel and must not be overridden.
APP_ENV=staging
VITE_APP_ENV=staging
APP_PROJECT=pepscriptrx-staging
VITE_APP_PROJECT=pepscriptrx-staging
VITE_SUPABASE_URL=https://yjexrleubnjuitiyjvoy.supabase.co
SUPABASE_URL=https://yjexrleubnjuitiyjvoy.supabase.co
VITE_SUPABASE_ANON_KEY=<staging-anon-key>

# Payment methods remain unavailable unless separately authorized.
VITE_WOOCOMMERCE_BRIDGE_VISIBLE=false
WOOCOMMERCE_BRIDGE_ENABLED=false
STRIPE_PAYMENTS_ENABLED=false

# Do not add production PayPal, Stripe, WooCommerce/MPS, service-role,
